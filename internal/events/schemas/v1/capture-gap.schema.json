{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anvil.dev/schemas/v1/capture-gap.json",
  "title": "Anvil capture gap (schema version 1)",
  "description": "An explicit record of lost capture evidence in one stream. Failed capture MUST report gaps and never silently succeed. A stream containing gaps cannot seal as sealed_complete.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gap_id", "run_id", "stream_id", "after_sequence", "reason", "detected_at", "detected_by"],
  "properties": {
    "schema_version": { "$ref": "defs.json#/$defs/schemaVersion" },
    "gap_id": { "$ref": "defs.json#/$defs/uuidv7" },
    "run_id": { "$ref": "defs.json#/$defs/uuidv7" },
    "stream_id": { "$ref": "defs.json#/$defs/uuidv7" },
    "after_sequence": {
      "description": "Sequence number in the stream after which the gap begins.",
      "type": "integer",
      "minimum": -1
    },
    "expected_count": {
      "description": "Number of events believed lost, if known.",
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "enum": ["buffer_overflow", "exporter_failure", "sdk_crash", "size_limit", "timeout", "unknown"]
    },
    "detail": { "type": "string" },
    "detected_at": { "$ref": "defs.json#/$defs/timestamp" },
    "detected_by": {
      "description": "Which side detected the loss.",
      "type": "string",
      "enum": ["sdk", "server"]
    }
  }
}

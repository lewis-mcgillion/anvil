{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anvil.dev/schemas/v1/run.json",
  "title": "Anvil run (schema version 1)",
  "description": "A single captured agent run. Capture completeness is tracked separately from execution outcome (docs/architecture.md, Storage and versioning).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "created_at",
    "capture_completeness",
    "execution_outcome",
    "adapter",
    "adapter_version"
  ],
  "properties": {
    "schema_version": { "$ref": "defs.json#/$defs/schemaVersion" },
    "run_id": { "$ref": "defs.json#/$defs/uuidv7" },
    "project_id": { "$ref": "defs.json#/$defs/uuidv7" },
    "created_at": { "$ref": "defs.json#/$defs/timestamp" },
    "capture_completeness": { "$ref": "defs.json#/$defs/captureCompleteness" },
    "execution_outcome": { "$ref": "defs.json#/$defs/executionOutcome" },
    "adapter": {
      "description": "Capture adapter name, e.g. \"google-adk\".",
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "description": "Pinned adapter version used for capture.",
      "type": "string",
      "minLength": 1
    },
    "agent_version_id": { "$ref": "defs.json#/$defs/uuidv7" },
    "trace_id": { "$ref": "defs.json#/$defs/traceId" },
    "source": {
      "description": "Provenance of the run: captured live, or a candidate produced by re-execution.",
      "type": "string",
      "enum": ["capture", "reexecution"]
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}

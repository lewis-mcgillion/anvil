{
  "$defs": {
    "EmptyFault": {
      "additionalProperties": false,
      "properties": {
        "fault_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Fault Id",
          "type": "string"
        },
        "target_invocation_path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*(/[A-Za-z0-9_][A-Za-z0-9_.:-]*)*$",
          "title": "Target Invocation Path",
          "type": "string"
        },
        "fault_type": {
          "const": "tool.empty_response",
          "title": "Fault Type",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/EmptyParameters"
        }
      },
      "required": [
        "fault_id",
        "target_invocation_path",
        "fault_type"
      ],
      "title": "EmptyFault",
      "type": "object"
    },
    "EmptyParameters": {
      "additionalProperties": false,
      "properties": {
        "simulated_latency_ms": {
          "default": 0,
          "maximum": 120000,
          "minimum": 0,
          "title": "Simulated Latency Ms",
          "type": "integer"
        },
        "jitter_ms": {
          "default": 0,
          "maximum": 120000,
          "minimum": 0,
          "title": "Jitter Ms",
          "type": "integer"
        },
        "response": {
          "default": "null",
          "enum": [
            "null",
            "object",
            "array",
            "text"
          ],
          "title": "Response",
          "type": "string"
        }
      },
      "title": "EmptyParameters",
      "type": "object"
    },

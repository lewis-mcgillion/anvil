  "additionalProperties": false,
  "properties": {
    "fault_plan_version": {
      "const": "1",
      "title": "Fault Plan Version",
      "type": "string"
    },
    "faults": {
      "items": {
        "discriminator": {
          "mapping": {
            "json_pointer.patch": "#/$defs/PatchFault",
            "prompt.injection": "#/$defs/TextFault",
            "stream.truncate": "#/$defs/TruncateFault",
            "tool.empty_response": "#/$defs/EmptyFault",
            "tool.exception": "#/$defs/ExceptionFault",
            "tool.malformed_response": "#/$defs/TextFault",
            "tool.timeout": "#/$defs/TimeoutFault"
          },
          "propertyName": "fault_type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ExceptionFault"
          },
          {
            "$ref": "#/$defs/TimeoutFault"
          },
          {
            "$ref": "#/$defs/EmptyFault"
          },
          {
            "$ref": "#/$defs/PatchFault"
          },
          {
            "$ref": "#/$defs/TruncateFault"
          },
          {
            "$ref": "#/$defs/TextFault"
          }
        ]
      },
      "maxItems": 100,
      "title": "Faults",
      "type": "array"
    }

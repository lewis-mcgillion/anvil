    "OfflineJSON": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/OfflineJSON"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/OfflineJSON"
